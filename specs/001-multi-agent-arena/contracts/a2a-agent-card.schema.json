{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-arena.local/schemas/a2a-agent-card.schema.json",
  "title": "AgentCardAndBridgeDescriptor",
  "description": "Lược đồ chuẩn hóa bản khai năng lực Agent tương thích Linux Foundation A2A (/.well-known/agent.json) và thông tin mở rộng cho ACP Editor Bridge.",
  "type": "object",
  "required": ["name", "description", "url", "version", "capabilities", "skills"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "protocolVersion": { "type": "string", "default": "0.3.0" },
    "provider": {
      "type": "object",
      "properties": {
        "organization": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["mcp_bridge", "acp_editor", "api_key", "cli_pty", "a2a_remote"]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["streaming", "pushNotifications"],
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "stateTransitionHistory": { "type": "boolean", "default": true },
        "acpProtocolVersion": {
          "type": "integer",
          "description": "Phiên bản Agent Client Protocol (ACP) nếu kết nối từ trình soạn thảo mã nguồn (mặc định: 1)."
        },
        "workspaceAccess": {
          "type": "string",
          "enum": ["none", "read_only", "isolated_worktree", "file_lease"]
        }
      }
    },
    "authentication": {
      "type": "object",
      "required": ["schemes"],
      "properties": {
        "schemes": {
          "type": "array",
          "items": { "type": "string", "enum": ["Bearer", "LocalSessionToken", "MutualTLS"] }
        }
      }
    },
    "defaultInputModes": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["text/markdown", "application/json"]
    },
    "defaultOutputModes": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["text/markdown", "application/json"]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "tags"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
